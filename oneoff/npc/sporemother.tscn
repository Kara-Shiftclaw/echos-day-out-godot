[node name="Dialogue" type="Node" parent="."]

[node name="FirstChat" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/FirstChat" instance=ExtResource("4_jlah5")]
text = "Hello, hello. I am Sporemother."
move_always = true

[node name="StandardTextBox2" parent="Dialogue/FirstChat" instance=ExtResource("4_jlah5")]
text = "The other is Sporemother too. Perhaps we are all Sporemother."
move_always = true

[node name="StandardTextBox3" parent="Dialogue/FirstChat" instance=ExtResource("4_jlah5")]
text = "Our hyphae reach across the entire valley. We see, feel, know all. Including you, Echo."
move_always = true

[node name="MultipleChoiceBox" parent="Dialogue/FirstChat" instance=ExtResource("5_sym7a")]
text = "We know things that would help you. We can share our knowledge, for a price."
move_always = true

[node name="Yes" parent="Dialogue/FirstChat/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "Yes"
enabled = true

[node name="No" parent="Dialogue/FirstChat/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "No No No No No"
enabled = true

[node name="Elaborate" parent="Dialogue/FirstChat/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "Elaborate"
enabled = true

[node name="Elaborate" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/Elaborate" instance=ExtResource("4_jlah5")]
text = "Hm, suspicious. Of course."
move_always = true

[node name="StandardTextBox2" parent="Dialogue/Elaborate" instance=ExtResource("4_jlah5")]
text = "To access our knowledge, you will need to watch a young sporeling."
move_always = true

[node name="StandardTextBox3" parent="Dialogue/Elaborate" instance=ExtResource("4_jlah5")]
text = "Give an offering, some energy, and it will tell you everything."
move_always = true

[node name="MultipleChoiceBox" parent="Dialogue/Elaborate" instance=ExtResource("5_sym7a")]
text = "Do you wish to help?"
move_always = true

[node name="Yes" parent="Dialogue/Elaborate/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "Yes"
enabled = true

[node name="No" parent="Dialogue/Elaborate/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "No"
enabled = true

[node name="Yes" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/Yes" instance=ExtResource("4_jlah5")]
text = "Wonderful. We knew you would."
move_always = true

[node name="StandardTextBox2" parent="Dialogue/Yes" instance=ExtResource("4_jlah5")]
text = "Be careful, it hungers."
move_always = true

[node name="YesWithMushMeal" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/YesWithMushMeal" instance=ExtResource("4_jlah5")]
text = "Oh! You have MUSH-MEAL!"
move_always = true

[node name="StandardTextBox2" parent="Dialogue/YesWithMushMeal" instance=ExtResource("4_jlah5")]
text = "We knew you to be a great host. You have arrived quite prepared."
move_always = true

[node name="YesTakeCare" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/YesTakeCare" instance=ExtResource("4_jlah5")]
text = "Take care of it, now."
move_always = true

[node name="No" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/No" instance=ExtResource("4_jlah5")]
text = "Hm, a shame."
move_always = true

[node name="StandardTextBox2" parent="Dialogue/No" instance=ExtResource("4_jlah5")]
text = "We will be here when you change your mind."
move_always = true

[node name="TalkAgainWithout" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="MultipleChoiceBox" parent="Dialogue/TalkAgainWithout" instance=ExtResource("5_sym7a")]
text = "Have you changed your mind? Will you take our knowledge?"
move_always = true

[node name="Yes" parent="Dialogue/TalkAgainWithout/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "Yes"
enabled = true

[node name="No" parent="Dialogue/TalkAgainWithout/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "No"
enabled = true

[node name="TalkAgainWith" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/TalkAgainWith" instance=ExtResource("4_jlah5")]
text = "It's wonderful to see you! It looks like it's growing quite well, too."
move_always = true

[node name="StandardTextBox2" parent="Dialogue/TalkAgainWith" instance=ExtResource("4_jlah5")]
text = "You've been a wonderful host. I hope the knowledge has been kind to you."
move_always = true

[node name="MultipleChoiceBox" parent="Dialogue/TalkAgainWith" instance=ExtResource("5_sym7a")]
text = "How have been things?"
move_always = true

[node name="Remove" parent="Dialogue/TalkAgainWith/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "Please take it off"
enabled = true

[node name="Keep" parent="Dialogue/TalkAgainWith/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "It's... great"
enabled = true

[node name="StandardTextBox3" parent="Dialogue/TalkAgainWith" instance=ExtResource("4_jlah5")]
text = "Wonderful. I'm glad it has been treating you so well."
move_always = true

[node name="StandardTextBox4" parent="Dialogue/TalkAgainWith" instance=ExtResource("4_jlah5")]
text = "The last host was less capable. Your fatty frame has proven far better."
move_always = true

[node name="TalkAgainWithMush" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/TalkAgainWithMush" instance=ExtResource("4_jlah5")]
text = "It's wonderful to see you! It seems to be enjoying that MUSH-MEAL as well."
move_always = true

[node name="StandardTextBox2" parent="Dialogue/TalkAgainWithMush" instance=ExtResource("4_jlah5")]
text = "We have been so lucky to have a responsible host like you."
move_always = true

[node name="MultipleChoiceBox" parent="Dialogue/TalkAgainWithMush" instance=ExtResource("5_sym7a")]
text = "How have been things?"
move_always = true

[node name="Keep" parent="Dialogue/TalkAgainWithMush/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "It's great!"
enabled = true

[node name="Remove" parent="Dialogue/TalkAgainWithMush/MultipleChoiceBox" instance=ExtResource("6_rvn50")]
choice_text = "Here, take it back"
enabled = true

[node name="StandardTextBox3" parent="Dialogue/TalkAgainWithMush" instance=ExtResource("4_jlah5")]
text = "Wonderful. I'm glad it has been treating you so well."
move_always = true

[node name="StandardTextBox4" parent="Dialogue/TalkAgainWithMush" instance=ExtResource("4_jlah5")]
text = "The last host was less capable. Your feeding regimen has proven far better."
move_always = true

[node name="OnRemove" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/OnRemove" instance=ExtResource("4_jlah5")]
text = "Hm? You want it removed? A shame."
move_always = true

[node name="StandardTextBox2" parent="Dialogue/OnRemove" instance=ExtResource("4_jlah5")]
text = "Oh well. Better no host than a resistant one."
move_always = true

[node name="StandardTextBox3" parent="Dialogue/OnRemove" instance=ExtResource("4_jlah5")]
text = "It looks extremely well-fed in your care. I pray you will return at some point."
move_always = true

[node name="OnRemoveMush" parent="Dialogue" instance=ExtResource("3_oogrh")]

[node name="StandardTextBox" parent="Dialogue/OnRemoveMush" instance=ExtResource("4_jlah5")]
text = "Hm? You don't want to have it anymore? Even with the MUSH-MEAL?"
move_always = true

[node name="StandardTextBox2" parent="Dialogue/OnRemoveMush" instance=ExtResource("4_jlah5")]
text = "Oh, I know what is happening. You need not say more."
move_always = true

[node name="StandardTextBox3" parent="Dialogue/OnRemoveMush" instance=ExtResource("4_jlah5")]
text = "You must have a date with another Sporecap, and wish to give them the MUSH-MEAL as a gift."
move_always = true

[node name="StandardTextBox4" parent="Dialogue/OnRemoveMush" instance=ExtResource("4_jlah5")]
text = "Of course, of course. We can take the sporeling back for now."
move_always = true

[node name="StandardTextBox5" parent="Dialogue/OnRemoveMush" instance=ExtResource("4_jlah5")]
text = "We hope your romantic pursuits succeed as well as your parenting, Echo."
move_always = true

