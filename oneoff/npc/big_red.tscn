[node name="FirstEncounter" parent="Dialogue" instance=ExtResource("4_sfqm8")]

[node name="StandardTextBox" parent="Dialogue/FirstEncounter" instance=ExtResource("5_02qom")]
text = "Oh thank Gaia, someone to TALK TO!"

[node name="StandardTextBox2" parent="Dialogue/FirstEncounter" instance=ExtResource("5_02qom")]
text = "Look, don't question the life decisions that got me stuck down here, just know I regret them."

[node name="StandardTextBox3" parent="Dialogue/FirstEncounter" instance=ExtResource("5_02qom")]
text = "I was trying to get away from this dumb mole that was destroying my roots, and now I'm here."

[node name="StandardTextBox4" parent="Dialogue/FirstEncounter" instance=ExtResource("5_02qom")]
text = "I hate it here! It's too humid and I don't like seafood! ...But it does beat dying."

[node name="StandardTextBox5" parent="Dialogue/FirstEncounter" instance=ExtResource("5_02qom")]
text = "Huh? You're trying to stop that same mole?"

[node name="StandardTextBox6" parent="Dialogue/FirstEncounter" instance=ExtResource("5_02qom")]
text = "Hell yeah, cheers!"

[node name="Repeat" parent="Dialogue" instance=ExtResource("4_sfqm8")]

[node name="StandardTextBox" parent="Dialogue/Repeat" instance=ExtResource("5_02qom")]
text = "Hey, come let me know when you've kicked her ass, okay?"

[node name="StandardTextBox2" parent="Dialogue/Repeat" instance=ExtResource("5_02qom")]
text = "Bring someone who can help dig me out, too. But someone who won't give me a hard time about it."

[node name="StandardTextBox3" parent="Dialogue/Repeat" instance=ExtResource("5_02qom")]
text = "Oh!! Snacks too! There is NOBODY down here to eat!"

