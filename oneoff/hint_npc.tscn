[node name="Text" type="Node" parent="."]

[node name="FirstChat" parent="Text" instance=ExtResource("3_ei62j")]

[node name="StandardTextBox" parent="Text/FirstChat" instance=ExtResource("4_cqvfm")]
text = "I sense a great energy from you! You must be the \"monster\" I've heard of, Echo, yes?"

[node name="StandardTextBox2" parent="Text/FirstChat" instance=ExtResource("4_cqvfm")]
text = "It's nice to find another great beast. Though, your size is... less than I had heard."

[node name="StandardTextBox3" parent="Text/FirstChat" instance=ExtResource("4_cqvfm")]
text = "I've sensed strange energy around here, is that yours?"

[node name="StandardTextBox5" parent="Text/FirstChat" instance=ExtResource("4_cqvfm")]
text = "Ah, of course!  I could help you find it... for a price."

[node name="StandardTextBox4" parent="Text/FirstChat" instance=ExtResource("4_cqvfm")]
text = "Don't get me wrong, I'd love to help for free, but I am ~FAMISHED~."

[node name="StandardTextBox6" parent="Text/FirstChat" instance=ExtResource("4_cqvfm")]
text = "If you help me feed, perhaps I can tell you what I sense?"

[node name="FirstChatBlob" parent="Text" instance=ExtResource("3_ei62j")]

[node name="StandardTextBox" parent="Text/FirstChatBlob" instance=ExtResource("4_cqvfm")]
text = "I sense a great energy from you! You must be the \"monster\" I've heard of, Echo, yes?"

[node name="StandardTextBox2" parent="Text/FirstChatBlob" instance=ExtResource("4_cqvfm")]
text = "It's nice to find another great beast. Especially one of such great weight!"

[node name="StandardTextBox3" parent="Text/FirstChatBlob" instance=ExtResource("4_cqvfm")]
text = "I'd love to join you in tubbiness, but my weight has been... diminished."

[node name="StandardTextBox5" parent="Text/FirstChatBlob" instance=ExtResource("4_cqvfm")]
text = "It pains me to offer scraps in return, but perhaps you could help me feed?"

[node name="MainMenu" parent="Text" instance=ExtResource("3_ei62j")]

[node name="MultipleChoiceBox" parent="Text/MainMenu" instance=ExtResource("5_cqvfm")]
text = "How goes it, fellow beast?"

[node name="Hint" parent="Text/MainMenu/MultipleChoiceBox" instance=ExtResource("6_lyahb")]
choice_text = "Ask For Help"

[node name="Feed" parent="Text/MainMenu/MultipleChoiceBox" instance=ExtResource("6_lyahb")]
choice_text = "Give Food"

[node name="Talk" parent="Text/MainMenu/MultipleChoiceBox" instance=ExtResource("6_lyahb")]
choice_text = "Chat"
enabled = true

[node name="Leave" parent="Text/MainMenu/MultipleChoiceBox" instance=ExtResource("6_lyahb")]
choice_text = "Talk later!"
enabled = true

[node name="StandardTextBox" parent="Text/MainMenu" instance=ExtResource("4_cqvfm")]
text = "See you around!"

[node name="Talk" type="Node" parent="Text"]

[node name="NoTalk" parent="Text" instance=ExtResource("3_ei62j")]

[node name="StandardTextBox" parent="Text/NoTalk" instance=ExtResource("4_cqvfm")]
text = "Sorry, I don't mean to be rude, but it's hard to chat on an empty stomach."

[node name="GiveFood" type="Node" parent="Text"]

[node name="Weight0" parent="Text/GiveFood" instance=ExtResource("3_ei62j")]

[node name="StandardTextBox" parent="Text/GiveFood/Weight0" instance=ExtResource("4_cqvfm")]
text = "Ahahaa!!! I knew I could trust someone like you!"

[node name="StandardTextBox2" parent="Text/GiveFood/Weight0" instance=ExtResource("4_cqvfm")]
text = "Mmmhmmm, that hit the spot!"

[node name="StandardTextBox3" parent="Text/GiveFood/Weight0" instance=ExtResource("4_cqvfm")]
text = "Well, I am true to my word. If you need insight on your next power, I can provide."

[node name="StandardTextBox4" parent="Text/GiveFood/Weight0" instance=ExtResource("4_cqvfm")]
text = "Of course, if you need more help, I do have room for ~seconds~."

