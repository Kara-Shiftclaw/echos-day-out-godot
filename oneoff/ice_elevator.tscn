[sub_resource type="GDScript" id="GDScript_cws3a"]
resource_name = "ice_elevator_tool"
script/source = "@tool
extends ReferenceRect

func _ready() -> void:
	resized.connect(on_resize)
	on_resize()

func on_resize() -> void:
	$Elevator.position.y = size.y
"

