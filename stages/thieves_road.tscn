[sub_resource type="GDScript" id="GDScript_i56ig"]
resource_name = "_txt_sword_mural"
script/source = "extends AbstractTextScript

func script() -> void:
	var smol_text_box := load_textbox(\"res://menu/dialogue/view/smol_text_box.tscn\")
	smol_text_box.textbox.move_always = true
	await txt(\"SWORD_MURAL_1\")
	await txt(\"SWORD_MURAL_2\")
	await smol_text_box.txt(self, \"SWORD_MURAL_3\")
"

