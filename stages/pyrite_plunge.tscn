[node name="Dialogue" type="Node" parent="Objects/MineWorm"]

[node name="Nothing" parent="Objects/MineWorm/Dialogue" instance=ExtResource("23_558cu")]

[node name="StandardTextBox" parent="Objects/MineWorm/Dialogue/Nothing" instance=ExtResource("24_rhjpj")]
text = "You must be a new miner, eh? Lucky for you, we've struck riches!"

[node name="StandardTextBox2" parent="Objects/MineWorm/Dialogue/Nothing" instance=ExtResource("24_rhjpj")]
text = "'Course, I can't mine it up myself, having no arms."

[node name="StandardTextBox3" parent="Objects/MineWorm/Dialogue/Nothing" instance=ExtResource("24_rhjpj")]
text = "Looks like the treasure is all yours, friend!"

[node name="Default" parent="Objects/MineWorm/Dialogue" instance=ExtResource("23_558cu")]

[node name="StandardTextBox" parent="Objects/MineWorm/Dialogue/Default" instance=ExtResource("24_rhjpj")]
text = "Oho! Looks like you've got something!"

[node name="MinerMessageTextBox" parent="Objects/MineWorm/Dialogue/Default" instance=ExtResource("24_rhjpj")]
text = "You have %d pyrite chunks? That translates to about... $0.00%03d Craterian dollars!"

[node name="StandardTextBox2" parent="Objects/MineWorm/Dialogue/Default" instance=ExtResource("24_rhjpj")]
text = "A hard day's work really does pay off, doesn't it?"

[node name="MaxHeld" parent="Objects/MineWorm/Dialogue" instance=ExtResource("23_558cu")]

[node name="StandardTextBox" parent="Objects/MineWorm/Dialogue/MaxHeld" instance=ExtResource("24_rhjpj")]
text = "What's that? You can't hold more than 500 chunks of Pyrite?"

[node name="StandardTextBox2" parent="Objects/MineWorm/Dialogue/MaxHeld" instance=ExtResource("24_rhjpj")]
text = "That's a shame. I was gonna sell my really cool hat for 750!"

