[node name="Nothing" parent="Objects/MineWorm/Dialogue" instance=ExtResource("23_558cu")]

[node name="StandardTextBox" parent="Objects/MineWorm/Dialogue/Nothing" instance=ExtResource("24_rhjpj")]
text = "You must be a new miner, eh? Lucky for you, we've struck riches!"

[node name="StandardTextBox2" parent="Objects/MineWorm/Dialogue/Nothing" instance=ExtResource("24_rhjpj")]
text = "'Course, I can't mine it up myself, having no arms."

[node name="StandardTextBox3" parent="Objects/MineWorm/Dialogue/Nothing" instance=ExtResource("24_rhjpj")]
