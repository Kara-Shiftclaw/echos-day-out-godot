[node name="Dialogue" type="Node" parent="Objects/Row1"]

[node name="First" parent="Objects/Row1/Dialogue" instance=ExtResource("23_558cu")]

[node name="StandardTextBox" parent="Objects/Row1/Dialogue/First" instance=ExtResource("24_rhjpj")]
text = "Well, someone's a bit early~`"
move_always = true

[node name="Second" parent="Objects/Row1/Dialogue" instance=ExtResource("23_558cu")]

[node name="StandardTextBox" parent="Objects/Row1/Dialogue/Second" instance=ExtResource("24_rhjpj")]
text = "Figures you'd get Edgar first~`"
move_always = true

[node name="Third" parent="Objects/Row1/Dialogue" instance=ExtResource("23_558cu")]

[node name="StandardTextBox" parent="Objects/Row1/Dialogue/Third" instance=ExtResource("24_rhjpj")]
text = "...Well SOMEONE took their sweet time~`"
move_always = true

[node name="Monologue" parent="Objects/Row1/Dialogue" instance=ExtResource("23_558cu")]

[node name="StandardTextBox" parent="Objects/Row1/Dialogue/Monologue" instance=ExtResource("24_rhjpj")]
text = "I take it introductions aren't necessary. Let's talk, one ~LEGEND~ to another."
move_always = true

[node name="StandardTextBox5" parent="Objects/Row1/Dialogue/Monologue" instance=ExtResource("24_rhjpj")]
text = "Do I have your powers? Yes. 
Do I regret it?
No."
move_always = true

[node name="StandardTextBox4" parent="Objects/Row1/Dialogue/Monologue" instance=ExtResource("24_rhjpj")]
text = "What's that look for??

Hey. Echo. Echo. LISTEN."
move_always = true

[node name="StandardTextBox2" parent="Objects/Row1/Dialogue/Monologue" instance=ExtResource("24_rhjpj")]
text = "I know you might be mad at me for that. Your feedback has been recieved."
move_always = true

[node name="StandardTextBox3" parent="Objects/Row1/Dialogue/Monologue" instance=ExtResource("24_rhjpj")]
text = "But have you considered, maybe you just weren't good enough to have them?"
move_always = true

[node name="StandardTextBox6" parent="Objects/Row1/Dialogue/Monologue" instance=ExtResource("24_rhjpj")]
text = "What about the age-old tradition, \"finders keepers losers weepers?\""
move_always = true

[node name="StandardTextBox7" parent="Objects/Row1/Dialogue/Monologue" instance=ExtResource("24_rhjpj")]
text = "What about the immense POWER I now hold over you?!?!`"
move_always = true

[node name="StandardTextBox8" parent="Objects/Row1/Dialogue/Monologue" instance=ExtResource("24_rhjpj")]
text = "Haha, okay, I think you get it. Goodbye, have fun dying! ~`"
move_always = true

