[node name="Dialogue" type="Node" parent="SoniaFight"]

[node name="Start" parent="SoniaFight/Dialogue" instance=ExtResource("23_558cu")]

[node name="StandardTextBox" parent="SoniaFight/Dialogue/Start" instance=ExtResource("24_rhjpj")]
text = "Haha wow, back already? I didn'y know you were such a fan~`"
move_always = true

[node name="StandardTextBox2" parent="SoniaFight/Dialogue/Start" instance=ExtResource("24_rhjpj")]
text = "Honestly, I think it's kinda cute that you want to fight me so bad."
move_always = true

[node name="StandardTextBox4" parent="SoniaFight/Dialogue/Start" instance=ExtResource("24_rhjpj")]
text = "It's cute how, despite these plants breaking MY tower, you think you're the victim here."
move_always = true

[node name="StandardTextBox5" parent="SoniaFight/Dialogue/Start" instance=ExtResource("24_rhjpj")]
text = "Most of all, it's cute how you think you stand any chance at all.`"
