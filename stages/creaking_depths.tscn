[node name="FirstChat" parent="Objects/DanielCutscene" instance=ExtResource("31_bt7xi")]

[node name="StandardTextBox" parent="Objects/DanielCutscene/FirstChat" instance=ExtResource("32_k4qsy")]
text = "Heyo. Sorry about before."

[node name="StandardTextBox2" parent="Objects/DanielCutscene/FirstChat" instance=ExtResource("32_k4qsy")]
text = "When you ran in and rang the bell, we thought you were like a scab or something."

[node name="StandardTextBox3" parent="Objects/DanielCutscene/FirstChat" instance=ExtResource("32_k4qsy")]
text = "I remember seeing you in Sonia's office, though. You're the one that showed her what for!"

[node name="StandardTextBox4" parent="Objects/DanielCutscene/FirstChat" instance=ExtResource("32_k4qsy")]
text = "Glad you knocked her down a peg. You can totally have that energy."

[node name="StandardTextBox5" parent="Objects/DanielCutscene/FirstChat" instance=ExtResource("32_k4qsy")]
text = "Now go out and... oh right!"

[node name="StandardTextBox6" parent="Objects/DanielCutscene/FirstChat" instance=ExtResource("32_k4qsy")]
text = "Frank, you can let her out now! She's chill."

[node name="Repeat" parent="Objects/DanielCutscene" instance=ExtResource("31_bt7xi")]

[node name="StandardTextBox" parent="Objects/DanielCutscene/Repeat" instance=ExtResource("32_k4qsy")]
text = "Normally we're the ones digging more space for the tower & such."

[node name="StandardTextBox2" parent="Objects/DanielCutscene/Repeat" instance=ExtResource("32_k4qsy")]
text = "Right now, we're somewhere between a long break and a union strike."

[node name="StandardTextBox3" parent="Objects/DanielCutscene/Repeat" instance=ExtResource("32_k4qsy")]
text = "Y'see, there was this massive flower that was cursing up a storm, and Sonia wanted it dead."

[node name="StandardTextBox5" parent="Objects/DanielCutscene/Repeat" instance=ExtResource("32_k4qsy")]
text = "And by cursing, I mean like demonic incantations on our next of kin."

[node name="StandardTextBox4" parent="Objects/DanielCutscene/Repeat" instance=ExtResource("32_k4qsy")]
text = "Usually killing deities like that is a bad idea, y'know? I'm sure you can relate."

