[sub_resource type="GDScript" id="GDScript_ti1c1"]
script/source = "extends Node2D

const Honey := preload(\"res://objects/enemies/honey.tscn\")

func _ready() -> void:
	Global._fireball = true
	Global.health = 15
	Global.recalculate_weight()

func honey_zone(other: Node2D) -> void:
	if other is Echo:
		var honey: Node2D = Honey.instantiate()
		other.add_child(honey)
"

