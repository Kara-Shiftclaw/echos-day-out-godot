text = "The Portal Core seems drawn to it, but it can't fit in the gap..."

[node name="InjectNoPortalCore" parent="Text" instance=ExtResource("3_tnatx")]

[node name="StandardTextBox" parent="Text/InjectNoPortalCore" instance=ExtResource("4_djgvg")]
text = "A wisp of air moves erratically. A Portal is present."

[node name="StandardTextBox2" parent="Text/InjectNoPortalCore" instance=ExtResource("4_djgvg")]
text = "If you find a Portal Core, you can slip inside."

[node name="InjectPortalCore" parent="Text" instance=ExtResource("3_tnatx")]

[node name="StandardTextBox" parent="Text/InjectPortalCore" instance=ExtResource("4_djgvg")]
text = "A wisp of air moves erratically. A Portal is present."

[node name="MultipleChoiceBox" parent="Text/InjectPortalCore" instance=ExtResource("5_djgvg")]
text = "Do you want to inject a Portal Core?"

[node name="Yes" parent="Text/InjectPortalCore/MultipleChoiceBox" instance=ExtResource("6_10cy8")]
choice_text = "Yes"
enabled = true

[node name="No" parent="Text/InjectPortalCore/MultipleChoiceBox" instance=ExtResource("6_10cy8")]
choice_text = "No"
enabled = true

[node name="PortalOpen" parent="Text" instance=ExtResource("3_tnatx")]

[node name="StandardTextBox" parent="Text/PortalOpen" instance=ExtResource("4_djgvg")]
text = "The Portal sprang open!"

[node name="PortalUse" parent="Text" instance=ExtResource("3_tnatx")]

[node name="MultipleChoiceBox" parent="Text/PortalUse" instance=ExtResource("5_djgvg")]
text = "It's a Portal.

Where will you go?"

[node name="Stay" parent="Text/PortalUse/MultipleChoiceBox" instance=ExtResource("6_10cy8")]
choice_text = "Stay Here"
enabled = true

[node name="StandardTextBox" parent="Text/PortalUse" instance=ExtResource("4_djgvg")]
