[node name="TooFat" parent="Text" instance=ExtResource("3_tnatx")]

[node name="StandardTextBox" parent="Text/TooFat" instance=ExtResource("4_djgvg")]
text = "You tried to squeeze into the portal... but you're too fat!"

[node name="StandardTextBox2" parent="Text/TooFat" instance=ExtResource("4_djgvg")]
text = "Maybe Kara can help widen the portals...?"

[node name="TooFatTimer" type="Timer" parent="."]
process_mode = 3
wait_time = 1.5
one_shot = true

[node name="PortalNoise" type="AudioStreamPlayer" parent="."]
stream = ExtResource("10_v5dss")
bus = &"Sfx"

[connection signal="area_entered" from="." to="." method="entered"]
[connection signal="area_exited" from="." to="." method="exited"]
[connection signal="body_entered" from="." to="." method="entered"]
[connection signal="body_exited" from="." to="." method="exited"]
[connection signal="next" from="Text/Nothing" to="." method="unpause"]
[connection signal="next" from="Text/PortalCoreNoInject" to="." method="unpause"]
[connection signal="next" from="Text/InjectNoPortalCore" to="." method="unpause"]
[connection signal="chosen" from="Text/InjectPortalCore/MultipleChoiceBox/Yes" to="." method="open"]
[connection signal="chosen" from="Text/InjectPortalCore/MultipleChoiceBox/No" to="." method="unpause"]
[connection signal="next" from="Text/PortalOpen" to="." method="unpause"]
[connection signal="next" from="Text/PortalUse" to="." method="unpause"]
[connection signal="chosen" from="Text/PortalUse/MultipleChoiceBox/Stay" to="Text/PortalUse/MultipleChoiceBox" method="emit_next"]
[connection signal="next" from="Text/TooFat" to="." method="too_fat_reset"]
[connection signal="timeout" from="TooFatTimer" to="Text/TooFat" method="render"]
